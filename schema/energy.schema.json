{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantenergy.tech/schema/energy.schema.json",
  "title": "EcoCompute energy-methodology report",
  "description": "One LLM inference energy measurement, in an MLCommons-style energy-reporting format. Not a certified benchmark result.",
  "type": "object",
  "required": ["schema_version", "benchmark", "scenario", "system_under_test", "workload", "measurement", "results"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["ecocompute-energy/1.0", "ecocompute-energy/1.2", "ecocompute-energy/1.3"]},
    "benchmark": {"type": "string", "const": "ecocompute-energy-methodology"},
    "follows_mlcommons_energy_reporting_conventions": {"type": "boolean"},
    "certified_benchmark_result": {"type": "boolean", "const": false},
    "scenario": {"type": "string", "enum": ["SingleStream", "Offline"]},
    "timestamp_utc": {"type": "string"},
    "system_under_test": {
      "type": "object",
      "required": ["gpu", "gpu_arch", "accelerator_count"],
      "properties": {
        "gpu": {"type": "string"},
        "gpu_arch": {"type": "string"},
        "accelerator_count": {"type": "integer", "minimum": 1},
        "host": {"type": "string"}
      }
    },
    "workload": {
      "type": "object",
      "required": ["model_name", "precision", "batch_size"],
      "properties": {
        "model_name": {"type": "string"},
        "params_b": {"type": ["number", "null"]},
        "precision": {"type": "string", "enum": ["FP16", "NF4", "INT8"]},
        "batch_size": {"type": "integer", "minimum": 1},
        "context_length": {"type": "integer"}
      }
    },
    "measurement": {
      "type": "object",
      "required": ["method", "sample_rate_hz"],
      "properties": {
        "method": {"type": "string"},
        "sample_rate_hz": {"type": "integer", "minimum": 10, "description": "ACHIEVED (not requested) NVML sample rate; Protocol v1.1 §4.1.2 requires >= 10 Hz"},
        "tokens_per_run": {"type": "integer"},
        "iterations": {"type": "integer", "description": "decode iterations within this run; NOT a count of independent trials"},
        "warmup": {"type": "integer"},
        "iterations_note": {"type": "string"}
      }
    },
    "thermal": {
      "type": "object",
      "description": "(schema 1.3) Thermal state of the card during the run. Protocol v1.1 §4.6.1: the report MUST record this block. Honest failure states are valid: steady_state_reached=false or basis='unavailable' must be reported as such, never fabricated. Structure defined here so validators can check it; the container does not yet emit it (tracked issue).",
      "required": ["mode", "basis"],
      "properties": {
        "mode": {"type": "string", "enum": ["cold", "steady"]},
        "basis": {"type": "string", "enum": ["measured", "unavailable"]},
        "warmup_runs": {"type": "integer", "minimum": 0},
        "cooldown_s": {"type": ["number", "null"], "description": "enforced cooldown between arms, seconds"},
        "temperature_start_c": {"type": ["number", "null"]},
        "temperature_steady_c": {"type": ["number", "null"]},
        "temperature_end_c": {"type": ["number", "null"]},
        "temperature_peak_c": {"type": ["number", "null"]},
        "steady_state_reached": {"type": ["boolean", "null"]},
        "note": {"type": "string"}
      }
    },
    "software": {
      "type": "object",
      "description": "Versions this run actually used. Quantization kernels change between bitsandbytes/transformers releases, so two reports are only directly comparable when these agree.",
      "properties": {
        "python": {"type": "string"},
        "packages": {"type": "object", "additionalProperties": {"type": "string"}},
        "torch_cuda": {"type": ["string", "null"]},
        "nvidia_driver": {"type": "string"},
        "reference_pins": {"type": "object", "additionalProperties": {"type": "string"}},
        "matches_reference_pins": {"type": "boolean"},
        "differs_from_reference_pins": {"type": "array", "items": {"type": "string"}},
        "comparability_note": {"type": "string"}
      }
    },
    "measurement_source": {"type": "string"},
    "results": {
      "type": "object",
      "required": ["energy_per_token_mj", "basis"],
      "properties": {
        "total_energy_joules": {"type": ["number", "null"]},
        "tokens_generated": {"type": ["integer", "null"]},
        "energy_per_token_mj": {"type": ["number", "null"], "description": "millijoules per generated token (== J per 1k tokens)"},
        "fp16_energy_per_token_mj": {"type": ["number", "null"]},
        "vs_fp16_energy_pct": {"type": ["number", "null"], "description": "signed % vs FP16; negative = quantization saves energy"},
        "avg_power_watts": {"type": ["number", "null"]},
        "throughput_tokens_per_s": {"type": ["number", "null"]},
        "basis": {"type": "string", "enum": ["measured", "interpolated", "extrapolated", "unavailable"]},
        "note": {"type": "string"}
      }
    },
    "quality": {
      "type": "object",
      "description": "Optional (schema 1.1+). Perplexity of this run's model on a fixed text, scored after the power sampler stopped so it does not enter the energy figure. Only delta_vs_fp16_pct is comparable across runs, and only between runs whose corpus.sha256 agrees.",
      "required": ["metric", "basis"],
      "properties": {
        "metric": {"type": "string", "enum": ["perplexity"]},
        "basis": {"type": "string", "enum": ["measured", "unavailable"]},
        "value": {"type": ["number", "null"], "description": "perplexity on this corpus with this tokenizer; NOT comparable with published WikiText numbers"},
        "fp16_value": {"type": ["number", "null"]},
        "delta_vs_fp16_pct": {"type": ["number", "null"], "description": "signed % vs the FP16 baseline measured in the same run; positive = quantization made the model worse"},
        "mean_nll": {"type": ["number", "null"]},
        "tokens_evaluated": {"type": ["integer", "null"]},
        "windows": {"type": ["integer", "null"]},
        "seq_len": {"type": ["integer", "null"]},
        "corpus": {
          "type": ["object", "null"],
          "properties": {
            "name": {"type": "string"},
            "bytes": {"type": "integer"},
            "sha256": {"type": "string"}
          }
        },
        "error": {"type": "string"},
        "delta_note": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "power_trace": {
      "type": "object",
      "description": "Optional (schema 1.3+). Raw NVML power samples of the whole run, dumped to sidecar CSV files (one per measured run: primary + optional FP16 baseline). The trace starts BEFORE the model is loaded, so the measurement window can be re-cut post hoc; the reported energy is unchanged by this option.",
      "required": ["format", "sample_rate_hz", "window", "files"],
      "properties": {
        "format": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "sample_rate_hz": {"type": "integer", "minimum": 10},
        "window": {"type": "string"},
        "window_note": {"type": "string"},
        "note": {"type": "string"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "file", "samples"],
            "properties": {
              "role": {"type": "string", "enum": ["primary", "fp16_baseline"]},
              "precision": {"type": "string"},
              "file": {"type": "string"},
              "samples": {"type": "integer", "minimum": 0},
              "dropped_samples": {"type": "integer", "minimum": 0},
              "phases": {
                "type": "object",
                "description": "Phase boundaries in seconds on this file's trace clock: trace_start_s, load_start_s, model_ready_s, warmup_end_s, measure_start_s, measure_end_s, optionally quality_start_s/quality_end_s, trace_end_s. The reported energy integrates only [measure_start_s, measure_end_s].",
                "additionalProperties": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "provenance": {"type": "object"},
    "trademark_notice": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "ecocompute-energy/1.3"}}},
      "then": {
        "required": ["software"],
        "properties": {
          "workload": {"required": ["model_name", "precision", "batch_size", "context_length"]},
          "measurement": {"required": ["method", "sample_rate_hz", "tokens_per_run", "iterations", "warmup"]}
        }
      }
    }
  ]
}
